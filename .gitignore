# 项目白名单
# 只同步当前保留的共享源码面

*

# Trellis 引导与 runtime 资产不属于本项目源码
.trellis/

# 保留的共享源码
# scripts/ 和 skills/ 仅作为已审计兼容面 / 外部 provider 占位保留；
# 真正产品源在 .imo/，声明见 .imo/providers/root_surfaces.json。
!.gitignore
!.npmignore
!package.json
!imo
!bin/
!bin/**
!.imo/
!.imo/**
!skills/
!skills/**
!scripts/
!scripts/**
!tasks/
!tasks/README.md

# skills 本地/工作区产物不入库
skills/**/workspace/
skills/**/*-workspace/
skills/local/
skills/pkg-dive-workspace/

# 临时文件
__pycache__/
*.pyc
*.pyo
.DS_Store
*.swp
*.swo
*~

# 冷存储
.cold-storage/
