# Project allowlist
# Sync only retained shared source surfaces

*

# Retained shared source
# scripts/ and skills/ are audited compatibility surfaces or external providers.
# Product source lives in .imo/; see .imo/providers/root_surfaces.json.
!.gitignore
!.npmignore
!package.json
!imo
!/.github/
!/.github/workflows/
!/.github/workflows/imo-verify.yml
!bin/
!bin/**
!.imo/
!.imo/**
!skills/
!skills/**
!scripts/
!scripts/**

# Exclude local skill and workspace artifacts
skills/**/workspace/
skills/**/*-workspace/
skills/local/

# Temporary files
__pycache__/
*.pyc
*.pyo
.DS_Store
*.swp
*.swo
*~
*.bak-*
.concurrency/
node_modules/
test-results/
*.tsbuildinfo

# Cold storage
.cold-storage/
