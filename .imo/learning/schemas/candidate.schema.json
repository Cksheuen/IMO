{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imo.local/schemas/learning/candidate.schema.json",
  "title": "IMO Learning Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "created_at",
    "updated_at",
    "status",
    "scope",
    "privacy",
    "confidence",
    "summary",
    "source_signal_refs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "rejected"]
    },
    "scope": {
      "type": "string",
      "enum": ["session", "task", "project", "global"]
    },
    "privacy": {
      "type": "string",
      "enum": ["public", "project_private", "sensitive"]
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "source_signal_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rejection_reason": {
      "type": ["string", "null"]
    }
  }
}
