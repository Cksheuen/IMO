{
  "schema_version": 1,
  "levels": [
    {
      "id": "raw_signal",
      "description": "Single correction, failure, preference hint, or behavior observation.",
      "allowed_writers": ["public_agent"],
      "promotion_gate": "none",
      "may_be_read_by_default": false
    },
    {
      "id": "candidate",
      "description": "Aggregated or high-value lesson proposal.",
      "allowed_writers": ["imo_learning_workflow", "hermes_like_self_iteration"],
      "promotion_gate": "candidate_review",
      "may_be_read_by_default": false
    },
    {
      "id": "active_digest",
      "description": "Short behavior guidance read by public agents.",
      "allowed_writers": ["imo_learning_workflow"],
      "promotion_gate": "digest_review",
      "may_be_read_by_default": true
    },
    {
      "id": "hard_rule_or_skill_update",
      "description": "Long-lived rule, skill, or source change.",
      "allowed_writers": ["explicit_task_review"],
      "promotion_gate": "hard_update_task_review",
      "may_be_read_by_default": false
    }
  ],
  "privacy_classes": [
    {
      "id": "public",
      "global_allowed": true,
      "description": "Stable user-level preference with no project-private fact."
    },
    {
      "id": "project_private",
      "global_allowed": false,
      "description": "Project path, project name, domain fact, implementation detail, or customer data."
    },
    {
      "id": "sensitive",
      "global_allowed": false,
      "description": "Credential, token, secret, or regulated/private data."
    }
  ],
  "scopes": ["session", "task", "project", "global"],
  "scope_transitions": [
    {
      "from": "session",
      "to": "task",
      "requires_gate": "candidate_review"
    },
    {
      "from": "task",
      "to": "project",
      "requires_gate": "candidate_review"
    },
    {
      "from": "project",
      "to": "global",
      "requires_gate": "digest_review",
      "requires_privacy": "public"
    }
  ],
  "promotion_gates": [
    {
      "id": "candidate_review",
      "requires": ["source_signal_refs", "scope", "privacy", "confidence"]
    },
    {
      "id": "digest_review",
      "requires": ["candidate_refs", "evidence_ref", "rollback_id", "disable_path"]
    },
    {
      "id": "hard_update_task_review",
      "requires": ["task_ref", "review_decision", "rollback_plan"]
    }
  ],
  "agent_permissions": {
    "public_agents": {
      "can_read_levels": ["active_digest"],
      "can_write_levels": ["raw_signal"],
      "cannot_write_levels": ["candidate", "active_digest", "hard_rule_or_skill_update"]
    },
    "hermes_like_self_iteration": {
      "can_read_levels": ["active_digest", "candidate"],
      "can_write_levels": ["candidate"],
      "cannot_write_levels": ["active_digest", "hard_rule_or_skill_update"]
    }
  },
  "safety_defaults": {
    "ambiguous_privacy_scope": "project",
    "raw_signal_default_weight": "low",
    "candidate_only_self_iteration": true,
    "global_learning_requires_public_privacy": true,
    "deferred_review_requires_explicit_command": true,
    "background_prepare_may_promote_digest": false,
    "unknown_activity_allows_background_prepare": false,
    "required_user_controls": ["list", "inspect", "disable", "reject", "promote", "reset"]
  }
}
