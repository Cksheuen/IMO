{
  "schema_version": 1,
  "rules": [
    {
      "id": "chameleon",
      "name": "Chameleon",
      "status": "active",
      "owner_surface": ".imo/product/rules/chameleon.md",
      "trigger": "Developing new or changed modules inside a mature project with established local conventions.",
      "context_summary": "For mature-project module work, inspect neighboring files and existing tests first; local evidence overrides generic model defaults, including heavy defensive programming, premature abstraction, and broad rewrites unless the user, local specs, or real risk require them.",
      "priority_order": [
        "explicit_user_instruction",
        "repository_hard_rules_or_specs",
        "local_neighboring_patterns",
        "active_imo_learning_digest",
        "generic_agent_training_defaults"
      ],
      "overrides_generic_habits": [
        "heavy_defensive_programming_without_local_boundary_need",
        "premature_abstraction",
        "broad_rewrites",
        "duplicated_helper_layers",
        "verbose_obvious_comments",
        "unsupported_fallback_paths"
      ],
      "required_sections": [
        "Summary",
        "Trigger",
        "Priority",
        "Required Local Evidence",
        "Habits To Suppress",
        "Implementation Behavior",
        "Allowed Exceptions",
        "Review Questions",
        "Non-Goals"
      ],
      "default_enabled": true,
      "integration_modes": [
        "context-guidance",
        "manual-review"
      ],
      "learning_access": {
        "read_digest": true,
        "write_signals": true
      }
    },
    {
      "id": "update-handoff",
      "name": "Update Handoff",
      "status": "active",
      "owner_surface": ".imo/product/rules/update-handoff.md",
      "trigger": "Changing IMO update, install, release, runtime-state, hook, or verification mechanics, or explaining how another device should update IMO.",
      "context_summary": "Before finishing affected IMO release or migration work, review .imo/UPDATE.md, update it when mechanics changed, and state whether the update method changed so another agent can perform the smallest safe cross-device refresh.",
      "priority_order": [
        "explicit_user_instruction",
        "repository_hard_rules_or_specs",
        "tracked_update_handoff",
        "current_local_source_evidence",
        "generic_agent_training_defaults"
      ],
      "overrides_generic_habits": [
        "conversation_history_as_update_source",
        "release_summary_without_update_review",
        "destructive_update_before_dirty_check",
        "runtime_state_as_disposable_source"
      ],
      "required_sections": [
        "Summary",
        "Trigger",
        "Priority",
        "Required Local Evidence",
        "Habits To Suppress",
        "Implementation Behavior",
        "Allowed Exceptions",
        "Review Questions",
        "Non-Goals"
      ],
      "default_enabled": true,
      "integration_modes": [
        "context-guidance",
        "manual-review"
      ],
      "learning_access": {
        "read_digest": true,
        "write_signals": true
      }
    },
    {
      "id": "structured-refactoring",
      "name": "Structured Refactoring",
      "status": "active",
      "owner_surface": ".imo/product/rules/structured-refactoring.md",
      "trigger": "Refactoring large, mixed-responsibility, or compatibility-sensitive modules in established projects.",
      "context_summary": "For structural refactors, preserve old imports and command paths with thin facades, split by responsibility, search for existing owners before creating shared helpers, keep source growth bounded, and validate with package-local checks.",
      "priority_order": [
        "explicit_user_instruction",
        "repository_hard_rules_or_specs",
        "local_neighboring_patterns",
        "active_imo_learning_digest",
        "generic_agent_training_defaults"
      ],
      "overrides_generic_habits": [
        "caller_migration_during_compatibility_refactor",
        "behavior_rewrite_hidden_as_refactor",
        "single_use_global_helpers",
        "props_heavy_over_splitting",
        "new_module_location_without_owner_search",
        "generated_host_output_edits",
        "line_count_slicing",
        "skipping_validation_for_import_moves"
      ],
      "required_sections": [
        "Summary",
        "Trigger",
        "Priority",
        "Required Local Evidence",
        "Habits To Suppress",
        "Implementation Behavior",
        "Allowed Exceptions",
        "Review Questions",
        "Non-Goals"
      ],
      "default_enabled": true,
      "integration_modes": [
        "context-guidance",
        "manual-review"
      ],
      "learning_access": {
        "read_digest": true,
        "write_signals": true
      }
    }
  ]
}
