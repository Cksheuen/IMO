{
  "schema_version": 1,
  "rules": [
    {
      "id": "delegated-coding",
      "name": "Delegated Coding",
      "status": "active",
      "owner_surface": ".imo/product/rules/delegated-coding.md",
      "trigger": "Choose direct work or bounded delegation from the user's instruction, task coupling and whether the result can be checked alone. Selected workers run through Herdr with explicit file ownership, the chosen model and a short report.",
      "context_summary": "Keep short or tightly coupled work in main unless delegation is asked for. Delegation uses Herdr and the exact chosen model via `delegate`; review the full diff and run the check before calling it done.",
      "priority_order": [
        "explicit_user_instruction",
        "repository_hard_rules_or_specs",
        "local_neighboring_patterns",
        "active_imo_learning_digest",
        "generic_agent_training_defaults"
      ],
      "overrides_generic_habits": [
        "delegating read-only or purely explanatory work only to satisfy a generic policy",
        "parallel workers without independent ownership",
        "full conversation history to a worker instead of delta context",
        "session split as substitute for a bounded task",
        "assuming model field is the effective provider/model",
        "silent provider/model fallback",
        "native subagents as the default or fallback for Herdr execution",
        "forcing delegation without independent value or bypassing an explicit route mandate",
        "large raw tool output inline",
        "treating worker startup or idle status as completion",
        "treating done, blocked, unknown, or process exit as a final project state",
        "waiting for an artifact before waking the parent or handling a failure",
        "claiming background execution without a verified return channel",
        "reasking standing delegation permission"
      ],
      "required_sections": [
        "Summary",
        "Trigger",
        "Priority",
        "Required Local Evidence",
        "Habits To Suppress",
        "Implementation Behavior",
        "Allowed Exceptions",
        "Review Questions",
        "Non-Goals"
      ],
      "default_enabled": true,
      "integration_modes": [
        "context-guidance",
        "manual-review"
      ],
      "learning_access": {
        "read_digest": true,
        "write_signals": true
      }
    },
