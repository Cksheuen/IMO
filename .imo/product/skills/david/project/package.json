{
  "name": "david",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:feedback": "node --watch --watch-preserve-output scripts/serve-feedback.mjs",
    "build": "vite build && node scripts/build-template.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:affected": "node scripts/run-tests.mjs --affected",
    "test:unit": "node scripts/run-tests.mjs --layer unit",
    "test:browser": "node scripts/run-tests.mjs --layer browser",
    "test:all": "node scripts/run-tests.mjs --all",
    "test:david-model": "node scripts/test-david-model.mjs",
    "test:feedback-service": "node scripts/test-feedback-service.mjs",
    "test:feedback-cli": "node scripts/test-feedback-cli.mjs",
    "test:feedback-transport": "node scripts/test-feedback-transport.mjs",
    "serve:feedback": "node scripts/serve-feedback.mjs",
    "david:feedback": "node scripts/david-feedback-cli.mjs",
    "test:drilldown": "node scripts/test-david-drilldown.mjs",
    "test:overview": "node scripts/test-overview-linking.mjs",
    "test:rich": "node scripts/test-rich-review.mjs",
    "test:feedback-rail": "node scripts/test-feedback-rail.mjs",
    "test:scenes": "node scripts/test-scene-transitions.mjs",
    "test:feedback-bridge": "node scripts/test-feedback-bridge.mjs",
    "test:page-interaction": "node scripts/test-page-interaction.mjs",
    "test:scene-runtime": "node scripts/test-scene-runtime.mjs",
    "test:ui-regressions": "node scripts/test-ui-regressions.mjs",
    "test:pages": "node scripts/test-pages-runtime.mjs",
    "test:render-e2e": "node scripts/test-render-review-e2e.mjs",
    "collab:cli": "node scripts/collaboration-cli.mjs",
    "probe:components": "node scripts/probe-components.mjs",
    "capture:evidence": "node scripts/capture-render-evidence.mjs",
    "capture:component": "node scripts/capture-component-evidence.mjs",
    "test:collab-cli": "node scripts/test-collaboration-cli.mjs",
    "test:change-block": "node scripts/test-change-block.mjs",
    "test:selection-context": "node scripts/test-selection-context.mjs",
    "test:canvas-transform": "node scripts/test-canvas-transform.mjs",
    "test:design-context": "node scripts/test-design-context.mjs",
    "test:refactor-a1": "node scripts/test-a1-refactor.mjs",
    "test:track-markers": "node scripts/test-track-markers.mjs",
    "test:open-questions": "node scripts/test-open-questions.mjs",
    "test:api-contracts": "node scripts/test-api-contracts.mjs",
    "design:context": "node scripts/extract-design-context.mjs",
    "test:david": "npm run test:all",
    "lint": "eslint .",
    "format": "prettier --write src scripts *.json *.ts",
    "format:check": "prettier --check src scripts *.json *.ts",
    "check": "npm run lint && npm run format:check && tsc --noEmit && node scripts/check-template.mjs",
    "review:context": "node scripts/review-context.mjs",
    "test:review-context": "node scripts/test-review-context.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.0"
  }
