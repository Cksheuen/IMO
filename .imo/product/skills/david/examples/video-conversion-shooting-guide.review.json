{
  "slug": "latam-video-conversion-shooting-guide",
  "title": "LATAM 视频转化提升 · 拍摄指南页评审",
  "subtitle": "只展示本轮拍摄指南页改动；按 Selling points 与 Top GMV video techniques 分框，并把每条需求、改动和真实字段逐行对齐。",
  "pageHtml": "<div class=\"app-phone\"><div class=\"app-nav\" data-review-target=\"app-nav\" data-review-label=\"导航栏\"><span class=\"app-nav-back\">←</span><span class=\"app-nav-title\">Product idea details</span></div><div class=\"app-product-card\" data-review-target=\"product-card\" data-review-label=\"商品信息卡片\"><div class=\"app-product-img\"></div><div class=\"app-product-info\"><div class=\"app-product-name\">Granado perfume</div><div class=\"app-product-meta\">Medicom ✓ | 10 in stock</div><div class=\"app-product-earn\">Earn $3.00</div><div class=\"app-product-price\">$19.71</div></div></div><div class=\"app-sp-card\" data-component-id=\"what-to-feature\" data-review-target=\"what-to-feature\" data-review-label=\"Selling points\"><div class=\"app-sp-header\"><h3 class=\"app-sp-title\" data-review-target=\"selling-points-title\" data-review-label=\"Selling points 标题\">✨ Selling points</h3><span class=\"app-sp-copy\">Copy</span></div><ul class=\"app-sp-list\" data-api-field=\"ProductIdeationData.short_selling_points\"><li class=\"app-sp-item\" data-review-target=\"selling-point-1\" data-review-label=\"Selling point 1\"><strong data-api-field=\"SellingPoint.value\">Long-lasting hydration</strong> <small data-api-field=\"SellingPoint.mentioned_by\">Mentioned by 42% of buyers</small></li><li class=\"app-sp-item\" data-review-target=\"selling-point-2\" data-review-label=\"Selling point 2\"><strong data-api-field=\"SellingPoint.value\">Lightweight texture</strong> <small data-api-field=\"SellingPoint.mentioned_by\">Mentioned by 31% of buyers</small></li><li class=\"app-sp-item\" data-review-target=\"selling-point-3\" data-review-label=\"Selling point 3\"><strong data-api-field=\"SellingPoint.value\">Fast absorption</strong> <small data-api-field=\"SellingPoint.mentioned_by\">Mentioned by 18% of buyers</small></li></ul><span class=\"app-sp-evidence\">Mentioned by 97% of buyers</span></div><div class=\"app-techniques\" data-component-id=\"top-gmv-techniques\" data-review-target=\"top-gmv-techniques\" data-review-label=\"Top GMV video techniques\"><h3 class=\"app-techniques-title\" data-review-target=\"top-gmv-title\" data-review-label=\"Top GMV video techniques 标题\">Top GMV video techniques</h3><div class=\"app-chip-row\" data-review-target=\"technique-chips\" data-review-label=\"Technique chips\" data-api-field=\"TechniqueData.technique_detail_list[].tag\"><span class=\"app-chip active\">All (35)</span><span class=\"app-chip\">Aesthetic appeal (17)</span><span class=\"app-chip\">Benefit first (12)</span><span class=\"app-chip\">Stress test (6)</span></div><div class=\"app-explain-card\" data-review-target=\"technique-explanation\" data-review-label=\"当前筛选说明\"><strong>Aesthetic appeal</strong> — 先展示结果，再用可见证据解释商品。</div><div class=\"app-video-grid\"><div class=\"app-video-card\" data-review-target=\"video-card-1\" data-review-label=\"视频卡片 1\" data-api-field=\"ProductIdeationData.inspiration_video_items[]\"><div class=\"app-video-thumb app-video-thumb-1\" data-api-field=\"VideoInspirationItem.video_meta\"><span class=\"app-gmv\">GMV $12.3K</span></div><div class=\"app-video-meta\" data-api-field=\"VideoInspirationItem.product_meta_list[]\"><div class=\"app-video-product-img\"></div><div class=\"app-video-product-name\">Open with the result</div></div></div><div class=\"app-video-card\" data-review-target=\"video-card-2\" data-review-label=\"视频卡片 2\" data-api-field=\"ProductIdeationData.inspiration_video_items[]\"><div class=\"app-video-thumb app-video-thumb-2\" data-api-field=\"VideoInspirationItem.video_meta\"><span class=\"app-gmv\">GMV $8.7K</span></div><div class=\"app-video-meta\" data-api-field=\"VideoInspirationItem.product_meta_list[]\"><div class=\"app-video-product-img\"></div><div class=\"app-video-product-name\">Demonstrate the texture</div></div></div><div class=\"app-video-card\" data-review-target=\"video-card-3\" data-review-label=\"视频卡片 3\" data-api-field=\"ProductIdeationData.inspiration_video_items[]\"><div class=\"app-video-thumb app-video-thumb-3\" data-api-field=\"VideoInspirationItem.video_meta\"><span class=\"app-gmv\">GMV $6.2K</span></div><div class=\"app-video-meta\" data-api-field=\"VideoInspirationItem.product_meta_list[]\"><div class=\"app-video-product-img\"></div><div class=\"app-video-product-name\">Stress test durability</div></div></div><div class=\"app-video-card\" data-review-target=\"video-card-4\" data-review-label=\"视频卡片 4\" data-api-field=\"ProductIdeationData.inspiration_video_items[]\"><div class=\"app-video-thumb app-video-thumb-4\" data-api-field=\"VideoInspirationItem.video_meta\"><span class=\"app-gmv\">GMV $4.1K</span></div><div class=\"app-video-meta\" data-api-field=\"VideoInspirationItem.product_meta_list[]\"><div class=\"app-video-product-img\"></div><div class=\"app-video-product-name\">Before and after comparison</div></div></div></div></div><div class=\"app-bottom-bar\" data-review-target=\"shooting-cta\" data-review-label=\"底部操作栏\"><button class=\"app-cta-secondary\">Generate scripts</button><button class=\"app-cta-primary\">Create video</button></div></div>",
  "components": [
    {
      "id": "what-to-feature",
      "label": "Selling points",
      "kind": "change",
      "kindLabel": "改动点 / F1",
      "mapping": [
        {
          "id": "f1-top-three",
          "requirement": "Selling points 固定展示前三条，页面打开即可完整看到，不保留 Show more 展开状态。",
          "change": "解析 short_selling_points 后只取 slice(0, 3)，始终渲染三条；移除 Show more、展开按钮和浮层状态。",
          "api": {
            "summary": "产品 ideation 详情接口以 JSON 字符串返回短卖点。",
            "fields": [
              {
                "name": "ProductIdeationData.short_selling_points",
                "type": "string",
                "meaning": "SellingPoint[] 的 JSON 字符串",
                "target": "selling-point-1 selling-point-2 selling-point-3"
              }
            ]
          }
        },
        {
          "id": "f1-evidence",
          "requirement": "每个卖点下方按所属卖点展示评论证据；没有证据时不留空行。",
          "change": "仅在 point.mentioned_by 非空时渲染浅色 Mentioned by evidence 行，证据与当前卖点同卡绑定。",
          "api": {
            "summary": "证据属于解析后的 SellingPoint 项，不单独发请求。",
            "fields": [
              {
                "name": "SellingPoint.key",
                "type": "string",
                "meaning": "卖点稳定 key",
                "target": "selling-point-1 selling-point-2 selling-point-3"
              },
              {
                "name": "SellingPoint.value",
                "type": "string",
                "meaning": "卖点文案",
                "target": "selling-point-1 selling-point-2 selling-point-3"
              },
              {
                "name": "SellingPoint.mentioned_by",
                "type": "string | number?",
                "meaning": "买家提及比例/证据，可为空",
                "target": "selling-point-1 selling-point-2 selling-point-3"
              }
            ]
          }
        },
        {
          "id": "f1-remove-violation",
          "requirement": "新 LATAM package 不展示 video_tips 对应的 Avoid content violation 卡片。",
          "change": "WhatToFeature 只渲染 Selling points 卡，删除违规提示卡及其展示入口；复制动作继续复用已有函数。",
          "api": {
            "summary": "本行是前端展示边界，不消费 video_tips。",
            "fields": [
              {
                "name": "ProductIdeationData.video_tips",
                "type": "VideoMakingTip?",
                "meaning": "本轮不渲染的旧提示数据"
              }
            ]
          }
        }
      ],
      "evidence": [
        "tech_design.md F1：前三项、mentioned_by 证据、删除违规卡。",
        "当前页面代码：app.tsx 解析 short_selling_points，WhatToFeature 使用 sellingPoints.slice(0, 3)。"
      ]
    },
    {
      "id": "top-gmv-techniques",
      "label": "Top GMV video techniques",
      "kind": "change",
      "kindLabel": "改动点 / F2",
      "mapping": [
        {
          "id": "f2-source",
          "requirement": "Top GMV video techniques 必须使用正式详情数据，不消费旧 mock 的 tabs/config 协议。",
          "change": "从 ProductIdeationData.inspiration_video_items[] 读取视频列表，从每条 video_technique.all_video_technique[] 读取技巧明细。",
          "api": {
            "summary": "数据来自 GetProductIdeationDetail 返回的 ProductIdeationData。",
            "fields": [
              {
                "name": "ProductIdeationData.inspiration_video_items[]",
                "type": "VideoInspirationItem[]?",
                "meaning": "拍摄指南页的视频卡片列表",
                "target": "video-card-1 video-card-2 video-card-3 video-card-4"
              },
              {
                "name": "VideoInspirationItem.video_technique.all_video_technique[]",
                "type": "TechniqueData[]?",
                "meaning": "全部技巧组",
                "target": "technique-chips technique-explanation video-card-1 video-card-2 video-card-3 video-card-4"
              }
            ]
          }
        },
        {
          "id": "f2-chips",
          "requirement": "筛选 chips 第一项固定为 All (N)，其余按 tag 首次出现顺序去重并显示命中数量。",
          "change": "遍历 technique_detail_list[].tag 构造去重 chips；默认选择 All，选择 tag 后只保留命中视频。",
          "api": {
            "summary": "筛选标签来自技巧明细的 tag，不新增配置接口。",
            "fields": [
              {
                "name": "TechniqueData.technique_detail_list[].tag",
                "type": "string",
                "meaning": "视频技巧筛选标签",
                "target": "technique-chips video-card-1 video-card-2 video-card-3 video-card-4"
              }
            ]
          }
        },
        {
          "id": "f2-card",
          "requirement": "视频卡片展示封面、首个商品图与名称，并能继续跳转视频拆解页；本轮不展示未提供的 GMV 数值。",
          "change": "使用两列 grid/flex-wrap 渲染视频卡片；点击继续复用 openLibraSchema；GMV 不从其他接口或旧 mock 猜测。",
          "api": {
            "summary": "卡片使用 VideoInspirationItem 的视频元数据和商品元数据。",
            "fields": [
              {
                "name": "VideoInspirationItem.video_meta",
                "type": "VideoMetadata?",
                "meaning": "封面、视频 ID 等视频信息",
                "target": "video-card-1 video-card-2 video-card-3 video-card-4"
              },
              {
                "name": "VideoInspirationItem.product_meta_list[]",
                "type": "ProductMetadata[]?",
                "meaning": "卡片首个商品信息",
                "target": "video-card-1 video-card-2 video-card-3 video-card-4"
              }
            ]
          }
        },
        {
          "id": "f2-empty",
          "requirement": "没有 inspiration_video_items 时，整个 Top GMV video techniques 模块不出现。",
          "change": "在页面层以列表长度判断是否挂载 TopGmvTechniques，空列表不渲染空容器。",
          "api": {
            "summary": "使用正式列表为空的事实控制模块可见性。",
            "fields": [
              {
                "name": "ProductIdeationData.inspiration_video_items",
                "type": "array?",
                "meaning": "为空时模块隐藏",
                "target": "video-card-1 video-card-2 video-card-3 video-card-4"
              }
            ]
          }
        }
      ],
      "evidence": [
        "tech_design.md F2：chips、说明、两列视频卡、空列表隐藏。",
        "当前 app.tsx：topGmvVideoList 来自 productIdeation.inspiration_video_items || []。"
      ]
    }
  ]
}
