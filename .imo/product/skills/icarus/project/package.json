{
  "name": "icarus-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "mods/*",
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build-mods.mjs",
    "check": "node scripts/check-mod-boundaries.mjs && node scripts/check-source.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "mod": "node ../scripts/mod.mjs"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.25.12",
    "postcss": "8.5.28",
    "postcss-selector-parser": "7.1.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.11"
  }
}
