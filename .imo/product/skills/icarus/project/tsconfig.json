{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@david/*": ["packages/david-source/src/*"]
    }
  },
  "include": [
    "mods/**/*.ts",
    "mods/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx"
  ]
}
