{
  "name": "@imo/icarus-mod-mock-cases",
  "version": "0.1.2",
  "type": "module",
  "description": "Switch mock scenarios, inspect JSON and preview trusted local HTML",
  "scripts": {
    "build": "node ../../../scripts/mod.mjs build ."
  },
  "files": [
    "mod.json",
    "dist/index.mjs"
  ],
  "exports": "./dist/index.mjs",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "license": "MIT",
  "icarusBuild": {
    "entry": "src/index.tsx",
    "sharedReact": true,
    "davidSource": true,
    "publicEntry": "src/public.tsx",
    "composes": [
      "rich-code"
    ]
  }
}
