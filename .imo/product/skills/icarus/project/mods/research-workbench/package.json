{
  "name": "@imo/icarus-mod-research-workbench",
  "version": "0.2.32",
  "type": "module",
  "description": "Question-led research with original David graphs, annotated code and comments",
  "scripts": {
    "build": "node ../../../scripts/mod.mjs build ."
  },
  "files": [
    "mod.json",
    "dist/index.mjs"
  ],
  "exports": "./dist/index.mjs",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "license": "MIT",
  "icarusBuild": {
    "entry": "src/index.mjs",
    "davidFrame": true,
    "composes": [
      "logic-canvas",
      "rich-code",
      "mock-cases",
      "resource-cards",
      "rich-content"
    ]
  }
}
