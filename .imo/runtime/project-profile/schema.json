{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imo.local/schemas/project-profile/current.schema.json",
  "title": "IMO Project Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "repo_root",
    "generated_at",
    "git",
    "source_fingerprint",
    "summary",
    "conventions",
    "suppressed_generic_habits",
    "evidence",
    "limits"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "repo_root": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "branch", "dirty"],
      "properties": {
        "head": {
          "type": ["string", "null"]
        },
        "branch": {
          "type": ["string", "null"]
        },
        "dirty": {
          "type": "boolean"
        }
      }
    },
    "source_fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "files", "top_level_entries"],
      "properties": {
        "digest": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "size"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "minLength": 1
              },
              "size": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "top_level_entries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["short_context", "lines"],
      "properties": {
        "short_context": {
          "type": "string",
          "minLength": 1
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "conventions": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "suppressed_generic_habits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["habit", "local_reason"],
        "properties": {
          "habit": {
            "type": "string",
            "minLength": 1
          },
          "local_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_context_chars", "scan_scope", "ttl_days"],
      "properties": {
        "max_context_chars": {
          "type": "integer",
          "minimum": 1
        },
        "scan_scope": {
          "type": "string",
          "minLength": 1
        },
        "ttl_days": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
